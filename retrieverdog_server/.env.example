# ============================================================
# RetrieverDog 环境变量配置文件
# 使用方法：复制本文件为 .env，然后填入你的真实密钥
# 注意：.env 文件不要提交到代码仓库
# ============================================================

# ---------- 千问 DashScope API Key（必填）----------
# 获取地址：https://dashscope.console.aliyun.com/apiKey
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# ---------- LlamaCloud API Key（PDF 解析用，必填）----------
# 获取地址：https://cloud.llamaindex.ai/
# 免费额度：每月 1000 页，个人学习足够
LLAMA_CLOUD_API_KEY=your_llama_cloud_api_key_here

# ---------- Tesseract OCR 路径（图片识别用）----------
# Windows 默认安装路径，如已改路径请自行修改
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# OCR 语言：chi_sim=简体中文，eng=英文，多个用 + 连接
TESSERACT_LANG=chi_sim+eng

# ---------- 模型配置 ----------
# LLM 模型名（千问系列）
LLM_MODEL=qwen3.7-flash
# Embedding 模型名（千问文本向量）
EMBED_MODEL=qwen3.7-text-embedding
# 重排序模型名（DashScope 云端）
RERANK_MODEL=qwen-rerank

# ---------- 文本分块参数 ----------
# 每个文本块的最大 token 数
CHUNK_SIZE=512
# 相邻块之间的重叠 token 数，保证语义连续性
CHUNK_OVERLAP=64

# ---------- 检索参数 ----------
# 第一阶段：向量检索 + BM25 混合召回数量
SIMILARITY_TOP_K=15
# 第二阶段：重排序后保留的片段数
RERANK_TOP_N=3
# 相似度过滤阈值，低于此分数的节点被丢弃
SIMILARITY_CUTOFF=0.0

# ---------- 服务配置 ----------
# 服务监听地址
HOST=0.0.0.0
# 服务端口
PORT=8002
